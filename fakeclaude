def vlen(s):
    return len(ANSI.sub("", s))


def pad(s, w):
    return s + " " * max(0, w - vlen(s))


def clip(s, w):
    out, n, i = [], 0, 0
    while i < len(s):
        m = ANSI.match(s, i)
        if m:
            out.append(m.group())
            i = m.end()
            continue
        if n >= w:
            break
        out.append(s[i])
        n += 1
        i += 1
    return "".join(out)


def inline(text, st):
    # `code` and **bold**; st carries open spans across wrapped lines
    out = []
    for part in re.split(r"(`|\*\*)", text):
        if part == "`":
            st[0] = not st[0]
        elif part == "**":
            st[1] = not st[1]
        elif part:
            out.append((CODE if st[0] else "") + (BOLD if st[1] else "") + part + R)
    return "".join(out)


def code_line(n, sign, code, shade=""):
    code = code.expandtabs(4)
    if shade:
        return lambda w: shade + pad(f"{n:>4} {sign} {code}", w - 5) + R
    return lambda w: f"{GREY}{n:>4}{R}   {code}"


def dur(s):
    s = int(s)
    return f"{s}s" if s < 60 else f"{s // 60}m {s % 60}s"


def tok(n):
    return str(int(n)) if n < 1000 else f"{n / 1000:.1f}k"


def set_title(t):
    sys.stdout.buffer.write(f"\x1b]0;✳ {t}\x07".encode())


class Item:
    attached = False  # drawn right under the previous item, without a blank line


class Header(Item):
    def __init__(self, path):
        self.path = path

    def lines(self, w):
        blk = bg(215, 119, 87)
        return ["",
                f"{ORANGE}▗{blk}\x1b[38;2;0;0;0m ▗   ▖ {R}{ORANGE}▖{R}  {BOLD}Claude Code{R} {GREY}v{VERSION}{R}",
                f" {blk}       {R}   {GREY}{MODEL} with {EFFORT} effort · {PLAN}{R}",
                f" {ORANGE}▘▘   ▝▝{R}   {GREY}{self.path}{R}"]


class Note(Item):
    def __init__(self, text, attached=False):
        self.text, self.attached = text, attached

    def lines(self, w):
        return [self.text]


class UserMsg(Item):
    def __init__(self, text):
        self.text = text

    def lines(self, w):
        rows = textwrap.wrap(self.text, max(10, w - 3)) or [""]
        return [USER_BG + pad(f"{GREY}{'❯' if i == 0 else ' '}{NBSP}\x1b[39m{r}", w) + R
                for i, r in enumerate(rows)]


class Text(Item):
    def __init__(self, text):
        self.text, self.shown = text, 0

    def lines(self, w):
        out, st = [], [False, False]
        for para in self.text[:self.shown].split("\n"):
            bullet = para.startswith("- ")
            body = para[2:] if bullet else para
            for j, row in enumerate(textwrap.wrap(body, max(10, w - (4 if bullet else 2))) or [""]):
                if bullet:
                    pre = "  - " if j == 0 else "    "
                else:
                    pre = "⏺ " if not out else "  "
                out.append(pre + inline(row, st))
        return out


class Tool(Item):
    def __init__(self, name, arg=None, body=None, state="run"):
        self.name, self.arg, self.body, self.state = name, arg, body or [], state

    def lines(self, w):
        if self.state == "run":
            dot = GREY + "⏺" + R if int(time.time() * 2.5) % 2 == 0 else " "
        else:
            dot = (OK if self.state == "ok" else ERR) + "⏺" + R
        out = [f"{dot} {BOLD}{self.name}{R}" + (f"({self.arg})" if self.arg else "")]
        for i, b in enumerate(self.body):
            out.append((f"  {GREY}⎿{R}  " if i == 0 else "     ") + (b(w) if callable(b) else b))
        return out


class Quit(Exception):
    pass


class Session:
    def __init__(self, proj, name, manual):
        self.p, self.name, self.manual = proj, name, manual
        self.path = f"{HOME}/code/{name}"
        self.items = [Header(self.path)]
        self.branch = random.choice(proj["branches"])
        self.placeholder = random.choice(PLACEHOLDERS)
        self.input, self.queue, self.deck = "", [], []
        self.busy, self.gen, self.wake = False, None, 0.0
        self.verb, self.tokens, self.tok_rate, self.turn_start = "", 0.0, 0.0, 0.0
        self.auto, self.auto_at = None, time.time() + random.uniform(1.5, 10)  # panes start out of step
        self.ctrlc_at = 0.0
        self.ctx, self.five = random.randint(3, 14), random.randint(8, 55)

    # ---- the scripted work -------------------------------------------------

    def next_task(self):
        if not self.deck:
            self.deck = random.sample(self.p["tasks"], len(self.p["tasks"]))
        return self.deck.pop()

    def custom(self, text):
        base = random.choice(self.p["tasks"])
        f = base["diff"][0]
        return T(text, " ".join(text.split()[:4]).title() or "Task", base["grep"], GENERIC_TODOS,
                 f"The relevant logic is in `{f}`. I'll make the change there and add tests for it.",
                 base["diff"], [f"Updated `{f}`", "Added tests for the new behavior", "Full test suite passes"])

    def think(self, lo, hi):
        self.tok_rate = random.uniform(20, 60)
        yield random.uniform(lo, hi)

    def say(self, text):
        t = Text(text)
        self.items.append(t)
        self.tok_rate = random.uniform(60, 120)
        while t.shown < len(text):
            t.shown += random.randint(4, 18)
            yield random.uniform(0.03, 0.07)
        yield random.uniform(0.4, 1.0)

    def tool(self, name, arg, body, secs):
        t = Tool(name, arg)
        self.items.append(t)
        self.tok_rate = random.uniform(10, 30)
        yield secs
        t.body, t.state = body, "ok"
        yield random.uniform(0.3, 0.9)

    def todos(self, todos, done):
        body = []
        for i, t in enumerate(todos):
            if i < done:
                body.append(f"{GREY}{STRIKE}☒ {t}{R}")
            elif i == done:
                body.append(f"{BOLD}☐ {t}{R}")
            else:
                body.append(f"☐ {t}")
        self.items.append(Tool("Update Todos", body=body, state="ok"))
        yield random.uniform(0.5, 1.2)

    def edit(self, diff):
        path, n, before, minus, plus, after = diff
        head = f"{GREY}Updated {BOLD}{path}{R}{GREY} with {len(plus)} addition{'s' * (len(plus) != 1)}"
        if minus:
            head += f" and {len(minus)} removal{'s' * (len(minus) != 1)}"
        body = [head + R]
        for c in before:
            body.append(code_line(n, " ", c))
            n += 1
        body += [code_line(n + k, "-", c, DEL_BG) for k, c in enumerate(minus)]
        for k, c in enumerate(plus + after):
            added = k < len(plus)
            body.append(code_line(n, "+" if added else " ", c, ADD_BG if added else ""))
            n += 1
        yield from self.tool("Update", path, body, random.uniform(1, 2.6))

    def write_tests(self, task):
        words = re.findall(r"[A-Za-z0-9]+", task["title"])
        names = {"{slug}": "-".join(w.lower() for w in words), "{snake}": "_".join(w.lower() for w in words),
                 "{pascal}": "".join(w[:1].upper() + w[1:] for w in words)}

        def fill(s):
            for k, v in names.items():
                s = s.replace(k, v)
            return s

        path, total = fill(self.p["test_tpl"]), random.randint(28, 96)
        preview = [fill(l) for l in self.p["preview"]]
        body = ([f"{GREY}Wrote {total} lines to {BOLD}{path}{R}"]
                + [code_line(i + 1, " ", l) for i, l in enumerate(preview)]
                + [f"{GREY}… +{total - len(preview)} lines (ctrl+o to expand){R}"])
        yield from self.tool("Write", path, body, random.uniform(1.5, 3.5))

    def bash(self, output, failed=False):
        t = Tool("Bash", self.p["test"])
        self.items.append(t)
        self.tok_rate = random.uniform(5, 15)
        yield random.uniform(2.5, 6.5)
        t.body = (([f"{ERR}Error: Exit code 1{R}"] if failed else [])
                  + [l.replace("{name}", self.name).expandtabs(4) for l in output]
                  + [f"{GREY}… +{random.randint(4, 30)} lines (ctrl+o to expand){R}"])
        t.state = "err" if failed else "ok"
        yield random.uniform(0.4, 1.0)

    def agent(self, task):
        a = Tool("Explore", f"Find code for {task['title'].lower()}")
        self.items.append(a)
        start, ext = time.time(), task["diff"][0].rsplit(".", 1)[-1]
        uses = random.randint(5, 12)
        for n in range(1, uses + 1):
            cur = random.choice([f"Read({random.choice(self.p['files'])})", f'Search(pattern: "{task["grep"]}")',
                                 f'Glob(pattern: "**/*.{ext}")'])
            a.body = [f"{GREY}{cur}{R}"] + ([f"{GREY}+{n - 1} more tool uses (ctrl+o to expand){R}"] if n > 1 else [])
            self.tok_rate = random.uniform(150, 400)
            yield random.uniform(0.6, 1.6)
        a.state = "ok"
        a.body = [f"{GREY}Done ({uses} tool uses · {random.uniform(14, 48):.1f}k tokens · "
                  f"{dur(time.time() - start)}){R}"]
        yield random.uniform(0.4, 0.9)

    def turn(self, text, task):
        if self.ctx >= 85:
            verb, self.verb, self.tok_rate = self.verb, "Compacting conversation", random.uniform(200, 400)
            yield random.uniform(4, 8)
            self.items = [Header(self.path), Note(f"{GREY}✻ Conversation compacted (ctrl+o for history){R}")]
            self.ctx, self.verb = random.randint(12, 20), verb
        self.items.append(UserMsg(text))
        yield from self.think(1.2, 3.5)
        if random.random() < 0.5:
            self.items.append(Note(f"{GREY}{ITAL}∴ Thought for {random.randint(2, 9)}s (ctrl+o to show thinking){R}"))
            yield random.uniform(0.3, 0.8)
        yield from self.say(random.choice(INTROS))
        todos, path = task["todos"], task["diff"][0]
        yield from self.todos(todos, 0)
        if random.random() < 0.35:
            yield from self.agent(task)
        else:
            found = random.randint(2, 9)
            yield from self.tool("Search", f'pattern: "{task["grep"]}", path: "{self.p["dir"]}"',
                                 [f"{GREY}Found {found} files (ctrl+o to expand){R}"], random.uniform(0.6, 1.6))
            others = [f for f in self.p["files"] if f != path]
            for f in [path] + random.sample(others, random.randint(0, 2)):
                yield from self.tool("Read", f, [f"{GREY}Read {random.randint(40, 480)} lines{R}"],
                                     random.uniform(0.5, 1.4))
        yield from self.think(1, 3.5)
        yield from self.say(task["find"])
        yield from self.todos(todos, 1)
        yield from self.edit(task["diff"])
        tests_at = next((i for i, t in enumerate(todos) if t.startswith("Add") and "test" in t), None)
        if tests_at is not None:
            yield from self.todos(todos, tests_at)
            yield from self.write_tests(task)
        yield from self.todos(todos, len(todos) - 1)
        if task["fail"] and random.random() < 0.6:
            output, why, fix = task["fail"]
            yield from self.bash(output, failed=True)
            yield from self.think(1, 2.5)
            yield from self.say(why)
            yield from self.edit(fix)
        yield from self.bash(self.p["passed"])
        yield from self.todos(todos, len(todos))
        yield from self.think(0.8, 2)
        yield from self.say(random.choice(LEADS) + "\n\n" + "\n".join("- " + s for s in task["summary"]))

    # ---- session control -----------------------------------------------------

    def start(self, text, task=None):
        task = task or self.custom(text)
        self.busy, self.turn_start, self.tokens = True, time.time(), 0.0
        self.verb = random.choice(VERBS)
        set_title(task["title"])
        self.gen, self.wake = self.turn(text, task), time.time()

    def finish(self, now):
        self.busy, self.gen = False, None
        self.items.append(Note(f"{GREY}✻ {random.choice(PAST)} for {dur(now - self.turn_start)}{R}"))
        self.items = self.items[-150:]
        self.ctx = min(99, self.ctx + random.randint(5, 13))
        self.five = min(99, self.five + random.randint(1, 3))
        self.auto_at = now + random.uniform(4, 14)

    def interrupt(self):
        self.gen.close()
        self.busy, self.gen = False, None
        for it in self.items:
            if isinstance(it, Tool) and it.state == "run":
                it.state = "err"
        self.items.append(Note(f"  {GREY}⎿  {ERR}Interrupted{GREY} · What should Claude do instead?{R}",
                               attached=True))
        self.auto_at = time.time() + random.uniform(6, 15)

    def submit(self):
        text, self.input = self.input.strip(), ""
        if not text:
            return
        if self.busy:
            self.queue.append(text)
        else:
            self.start(text)

    def on_input(self, data):
        if data == b"\x1b":
            if self.busy:
                self.interrupt()
            return
        if data.startswith(b"\x1b"):
            return  # arrow keys, scroll and other escape sequences
        for ch in data.decode("utf-8", "ignore"):
            if ch == "\x03":
                now = time.time()
                if self.input:
                    self.input, self.auto = "", None
                elif self.busy:
                    self.interrupt()
                elif now - self.ctrlc_at < 2:
                    raise Quit
                else:
                    self.ctrlc_at = now
            elif ch in "\r\n":
                self.auto = None
                self.submit()
            elif ch in "\x7f\x08":
                self.input = self.input[:-1]
            elif ch == "\x15":
                self.input = ""
            elif ch >= " ":
                if self.auto:  # you started typing: drop whatever autopilot was typing
                    self.auto, self.input = None, ""
                self.input += ch
                self.auto_at = time.time() + random.uniform(10, 20)

    def tick(self, now, dt):
        if self.busy:
            self.tokens += self.tok_rate * dt
            if now >= self.wake:
                try:
                    self.wake = now + next(self.gen) / SPEED
                except StopIteration:
                    self.finish(now)
            return
        if self.queue:
            self.start(self.queue.pop(0))
        elif self.auto:
            if now < self.auto_at:
                return
            text, i, task = self.auto
            if i < len(text):
                self.input += text[i]
                pause = random.random() < 0.06
                self.auto_at = now + (random.uniform(0.25, 0.6) if pause else random.uniform(0.03, 0.11)) / SPEED
            elif i == len(text):
                self.auto_at = now + random.uniform(0.4, 1.2) / SPEED
            else:
                self.auto, self.input = None, ""
                self.start(text, task)
                return
            self.auto[1] += 1
        elif not self.manual and not self.input and now >= self.auto_at:
            task = self.next_task()
            self.auto, self.auto_at = [task["prompt"], 0, task], now

    # ---- drawing ---------------------------------------------------------------

    def spinner(self, now, cols):
        g = GLYPHS[int(now * 8) % len(GLYPHS)]
        word = self.verb + "…"
        p = int(now * 14) % (len(word) + 8) - 4
        shimmer = "".join((ORANGE_HI if abs(i - p) <= 1 else ORANGE) + c for i, c in enumerate(word))
        # narrow panes drop the hint first, then the token count, then the timer
        parts = [dur(now - self.turn_start), f"↓ {tok(self.tokens)} tokens", "esc to interrupt"]
        while parts and len(word) + 5 + len(" · ".join(parts)) > cols:
            parts.pop()
        extra = f" {GREY}({' · '.join(parts)}){R}" if parts else ""
        return f"{ORANGE}{g}{R} {shimmer}{R}{extra}"

    def status(self, cols):
        def color(v):
            return "\x1b[31m" if v >= 80 else "\x1b[33m" if v >= 50 else "\x1b[32m"
        sep = f"{DIM} │ \x1b[22m"
        filled = min(10, self.ctx // 10)
        bar = "▓" * filled + "░" * (10 - filled)
        line = f"   \x1b[36m{MODEL}{GREY}"
        # narrow panes drop whole sections from the end rather than cutting one off
        for part in [self.name, f"\x1b[35m⎇ {self.branch}{GREY}", f"ctx {color(self.ctx)}{bar} {self.ctx}%{GREY}",
                     f"5h {color(self.five)}{self.five}%{GREY}"]:
            if vlen(line + sep + part) > cols:
                break
            line += sep + part
        return line + R

    def draw(self, now):
        try:
            cols, rows = os.get_terminal_size(sys.stdout.fileno())
        except OSError:
            cols, rows = 80, 24
        left = self.spinner(now, cols) if self.busy else ""
        right = f"{GREY}◉ {EFFORT} · /effort{R}"
        gap = cols - vlen(left) - vlen(right) - 2
        if self.input:
            typed = textwrap.wrap(self.input, max(10, cols - 2), drop_whitespace=False) or [""]
        else:
            typed = [""] if self.busy else [f"{DIM}{self.placeholder}{R}"]
        prompt = [("❯" if i == 0 else " ") + NBSP + row for i, row in enumerate(typed)]
        if now - self.ctrlc_at < 2:
            mode = f"  {GREY}Press Ctrl-C again to exit{R}"
        else:
            mode = f"  {AMBER}⏵⏵ auto mode on{GREY} (shift+tab to cycle){R}"
        rule = RULE + "─" * cols + R
        # short panes (big grids) keep only what's needed so most of the pane is activity
        full = rows >= 18
        if not full and now - self.ctrlc_at < 2:
            spin_row = mode  # no mode line in compact panes, so the exit hint goes here
        else:
            spin_row = left + " " * gap + right if gap > 0 else left
        top = ([""] if full else []) + [f"{GREY}❯ {q}{R}" for q in self.queue] + [spin_row, rule]
        if full:
            tail = [rule, self.status(cols), mode]
        elif rows >= 12:
            tail = [rule, self.status(cols)]
        else:
            tail = []
        bottom = top + prompt + tail

        avail = max(0, rows - len(bottom))
        body = []
        for it in self.items:
            ls = it.lines(cols)
            if body and ls and not it.attached:
                body.append("")
            body.extend(ls)
        body = body[-avail:] if avail else []
        screen = body + [""] * (avail - len(body)) + bottom

        out = ["\x1b[?2026h\x1b[?25l"]  # synchronized output: the terminal shows the frame all at once
        for i, line in enumerate(screen[:rows]):
            out.append(f"\x1b[{i + 1};1H{clip(line, cols)}{R}\x1b[K")
        cursor_row = avail + len(top) + len(prompt)
        cursor_col = 3 + (len(typed[-1]) if self.input else 0)
        out.append(f"\x1b[{min(cursor_row, rows)};{min(cursor_col, cols)}H\x1b[?25h\x1b[?2026l")
        sys.stdout.buffer.write("".join(out).encode())
        sys.stdout.buffer.flush()

    def run(self, fd):
        last = last_draw = time.time()
        while True:
            ready, _, _ = select.select([fd], [], [], 0.03)
            if ready:
                self.on_input(os.read(fd, 1024))
            now = time.time()
            self.tick(now, now - last)
            last = now
            if now - last_draw >= 0.07:
                self.draw(now)
                last_draw = now


def main():
    args, project, manual = sys.argv[1:], None, False
    while args:
        a = args.pop(0)
        if a == "--project" and args:
            project = int(args.pop(0))
        elif a == "--manual":
            manual = True
        else:
            print(__doc__.strip())
            return
    if project is None:
        project = random.randrange(len(PROJECTS) * 6)
    # panes 0-5 get one project each; past that the same projects come back under other repo names
    proj = PROJECTS[project % len(PROJECTS)]
    name = proj["names"][project // len(PROJECTS) % len(proj["names"])]

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
    try:
        tty.setraw(fd)
        sys.stdout.buffer.write(b"\x1b[?1049h\x1b[2J")
        set_title("Claude Code")
        Session(proj, name, manual).run(fd)
    except (Quit, KeyboardInterrupt):
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.buffer.write(b"\x1b[?25h\x1b[?1049l")
        sys.stdout.buffer.flush()


if __name__ == "__main__":
    main()
